@page "/"
@using TP3.GUI.Common.Components

@inject TP3ClientWrapper TP3Client
@inject NavigationManager NavigationManager
@inject ServerManager ServerManager

<Framed>
    <pre class="code">
    TP3 - 
        Three Plus 3
        Tree plus 3
    </pre>
</Framed>

<Framed>
    <div>
        
        <button class="btn btn-primary" @onclick="OnClick">Connect to existing server</button>
    </div>
    <div>
         <button class="btn btn-primary" @onclick="OnStartServer">Start server</button>

    </div>
</Framed>

<Framed>
    @if(TP3Client.Status == "Connected")
    {
        <Walker></Walker>
    }
    else
    {
        <p>Not connected to IPC server.</p>
    }
</Framed>

@code
    {
    private string serverAddress = string.Empty;

    private async Task OnClick()
    {
        try
        {
            await TP3Client.Connect();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to IPC server: {ex.Message}");
        }
    }

    private void OnStartServer()
    {
        ServerManager.StartServer();
    }
}