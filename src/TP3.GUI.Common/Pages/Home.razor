@page "/"
@using TP3.GUI.Common.Components

@inject TP3ClientWrapper TP3Client

<div class="text-center">🌳✚3️⃣ <ConnectionStatus></ConnectionStatus></div>

<Framed>
    @if(TP3Client.Status == "Attached")
    {
        <div class="d-flex flex-wrap gap-3 align-items-start">
            <section class="border rounded-3 p-3 bg-body" style="flex: 1 1 24rem; min-width: 20rem;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <strong>Walker</strong>
                    <span class="badge text-bg-dark">fixed</span>
                </div>
                <Walker OnFileSelected="OpenFileFrame" OnCommandSelected="OpenCommandFrame"></Walker>
            </section>

            @foreach (var frame in frames)
            {
                var frameId = frame.Id;
                <section class="border rounded-3 p-3 bg-body" style="flex: 1 1 24rem; min-width: 20rem; max-width: 34rem;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div>
                            <div class="small text-body-secondary">@frame.Caption</div>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CloseFrame(frameId)">Close</button>
                    </div>

                    @if (frame.Type == FrameType.FilePreview)
                    {
                        <FilePreviewControl CurrentPath="@frame.Path" ></FilePreviewControl>
                    }
                    else
                    {
                        <CommandControl Path="@frame.Path" />
                    }
                </section>
            }
        </div>
    }
    else
    {
        <p>Not connected to IPC server.</p>
    }
</Framed>

@code
{
    private readonly List<DynamicFrame> frames = new();

    private string Tag=String.Empty;

    private void OpenFileFrame((string Tag, string Name,  string[] Path) file)
    {
        frames.Add(new DynamicFrame
        {
            Type = FrameType.FilePreview,
            Caption = $"File: {file.Name}",
            Path = file.Path,
        });
    }

    private void OpenCommandFrame((string Name, string[] Path) command)
    {
        frames.Add(new DynamicFrame
        {
            Type = FrameType.Command,
            Caption = $"Command: {command.Name}",
            Path = command.Path,
        });
    }


    private void CloseFrame(Guid id)
    {
        frames.RemoveAll(f => f.Id == id);
    }

    protected override async Task OnInitializedAsync()
    {
        await TP3Client.Connect();
    }

    private sealed class DynamicFrame
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public FrameType Type { get; set; }
        public string Caption { get; set; } = string.Empty;
        public string[] Path { get; set; } = Array.Empty<string>();
    }

    private enum FrameType
    {
        FilePreview,
        Command
    }
}