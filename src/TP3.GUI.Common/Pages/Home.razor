@page "/"
@using TP3.GUI.WebDav

@inject TP3ClientWrapper TP3Client
@inject NavigationManager NavigationManager

<pre class="code">
TP3 - 
    Three Plus 3
    Tree plus 3
</pre>

<button class="btn btn-primary" @onclick="OnClick">Connect</button>

<button class="btn btn-primary" @onclick="OnClickDej">Dej</button>

@code
{
    private async Task OnClickDej()
    {
        try
        {
            var s = new Server();
            s.Start();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to IPC server: {ex.Message}");
        }
    }

    private async Task OnClick()
    {

        
        try
        {
            await TP3Client.Connect();
            NavigationManager.NavigateTo("/walk");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to IPC server: {ex.Message}");
        }
    }
}