@page "/"
@using TP3.GUI.Common.Components

@inject TP3ClientWrapper TP3Client
@inject NavigationManager NavigationManager

<Framed>
    <pre class="code">
    TP3 - 
        Three Plus 3
        Tree plus 3
    </pre>
</Framed>

<Framed>
    <p>Welcome to the TP3 GUI. This is a simple interface to interact with the TP3 IPC server.</p>
    
    <button class="btn btn-primary" @onclick="OnClick">Connect to existing server</button>
    <input type="text" class="form-control mt-2" placeholder="Enter server address" @bind="serverAddress" />
    
    <button class="btn btn-primary" @onclick="OnClick">Start server</button>
</Framed>

<Framed>
    @if(TP3Client.Status == "Connected")
    {
        <Walker></Walker>
    }
    else
    {
        <p>Not connected to IPC server.</p>
    }
</Framed>

@code
{
    private string serverAddress = string.Empty;

    private async Task OnClick()
    {
        try
        {
            await TP3Client.Connect();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to IPC server: {ex.Message}");
        }
    }
}