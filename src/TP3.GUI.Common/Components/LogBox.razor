@inject ILogger logger;

<pre class="w-100">@loglines
</pre>


@code
{
    public string loglines {get; set;} = "";

    override protected void OnInitialized()
    {
        var m = logger as MauiLogger;
        if (m != null)
        {
            m.OnLogMessage += (logLevel, message) =>
            {
                // leve and short timestamp
                string line = $"[{logLevel.ToString()} {DateTime.Now:HH:mm:ss}] {message}";
                Console.WriteLine(line);
                loglines = line + "\n" + loglines; 
                InvokeAsync(StateHasChanged);
            };
        }
    }
}