<li class="list-group-item d-flex align-items-center justify-content-between">
    <button class="btn" @onclick="OnClick">
        <span class="me-2">⚙</span>
        @Item.Name
    </button>
    <span class="badge text-bg-warning">command</span>
</li>

@code {
    [Parameter, EditorRequired]
    public TP3.Protocol.TP3StatPayload Item { get; set; } = default!;

    [Parameter]
    public EventCallback<TP3.Protocol.TP3StatPayload> OnCommandClick { get; set; }

    private Task OnClick()
    {
        return OnCommandClick.InvokeAsync(Item);
    }
}
