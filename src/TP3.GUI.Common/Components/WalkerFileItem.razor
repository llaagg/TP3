@inject TP3ClientWrapper TP3Client

<li class="list-group-item d-flex align-items-center justify-content-between">
    <button class="btn" @onclick="OnClick">
        <span class="me-2">📄</span>
        @Item.Name
    </button>
    <span class="badge text-bg-primary">file</span>
</li>

@code {
    [Parameter, EditorRequired]
    public TP3.Protocol.TP3StatPayload Item { get; set; } = default!;

    [Parameter]
    public string[] CurrentPath { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback<(string Tag, string Name, string Content)> OnFileOpened { get; set; }

    private async Task OnClick()
    {
        List<string> pathList = CurrentPath.ToList();
        pathList.Add(Item.Name);

        var tag = await TP3Client.NewSession(pathList.ToArray());

        try
        {
            var stream = TP3Client.GetStream(tag);
            string content;
            using (var reader = new StreamReader(stream))
            {
                content = await reader.ReadToEndAsync();
            }

            await OnFileOpened.InvokeAsync((tag, Item.Name, content));
        }
        finally
        {
            await TP3Client.CloseSession(tag);
        }
    }
}
