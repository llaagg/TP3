@inject TP3ClientWrapper TP3Client
@inject ILogger     logger

<div class="d-flex align-items-center mb-3">
    <span class="me-2">Path:</span>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="/walk" @onclick="() => navigateToRoot()">Root</a>
            </li>
            @for (int i = 0; i < currentPath.Length; i++)
            {
                var segment = currentPath[i];
                if (i == currentPath.Length - 1)
                {
                    <li class="breadcrumb-item active" aria-current="page">@segment</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="@GetFolderUrl(segment)" @onclick="() => navigateToSegment(i)">@segment</a>
                    </li>
                }
            }
        </ol>
    </nav>
</div>

<ul class="list-group list-group-flush">


    @foreach (var item in folderContents)
    {
        if (item.Info.NodeType == TP3.Messages.NodeType.Directory)
        {
            <li class="list-group-item d-flex align-items-center justify-content-between">
                <button class="btn" @onclick="() => navigate(item)">
                    <span class="me-2">@GetIcon(item)</span>
                    @item.Name
                </button>
                <span class="badge text-bg-secondary">folder</span>
            </li>
        }
        else
        {
            <li class="list-group-item d-flex align-items-center justify-content-between">
                <button class="btn" @onclick="() => loadFile(item)">
                    <span class="me-2">@GetIcon(item)</span>
                    @item.Name
                </button>
                <span class="badge text-bg-primary">file</span>
            </li>
        }
    }
</ul>

@code {
    [Parameter] 
    public string? Folder { get; set; }

    // dump file to logger
    private async Task loadFile(TP3.Protocol.TP3StatPayload item)
    {
        List<string> pathList = currentPath.ToList();
        pathList.Add(item.Name);

        var ourRootSesion = await TP3Client.NewSession(pathList.ToArray());

        var d = TP3Client.GetStream(ourRootSesion);

        await Task.Run(()=>{
            using (var reader = new StreamReader(d))
            {
                var data = reader.ReadToEnd();
                logger.LogInformation("File contents of {FileName}:\n{FileContents}", item.Name, data);
            }
        });
        
    }


    private async Task navigateToRoot()
    {
        currentPath = Array.Empty<string>();
        folderContents.Clear();
        await load(currentPath);
    }

    private async Task navigateToSegment(int index)
    {
        currentPath = currentPath.Take(index + 1).ToArray();
        folderContents.Clear();
        await load(currentPath);
    }

    private string[] currentPath = Array.Empty<string>();

    List<TP3.Protocol.TP3StatPayload> folderContents = new List<TP3.Protocol.TP3StatPayload>();

    async Task navigate(TP3.Protocol.TP3StatPayload item)
    {
        currentPath = currentPath.Append(item.Name).ToArray();
        this.folderContents.Clear();
        await load(currentPath.ToArray());
    }

    async Task load(IList<string> path)
    {
        var ourRootSesion = await TP3Client.NewSession(path.ToArray());

         await TP3Client.ListFolder(
            ourRootSesion,
            async (response) =>
        {
            if (response != null)
            {
                folderContents.Add(response);
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    override protected async Task OnInitializedAsync()
    {
        currentPath = string.IsNullOrWhiteSpace(Folder)
            ? Array.Empty<string>()
            : Uri.UnescapeDataString(Folder)
                .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        await load(this.currentPath);
       
    }

    private string GetFolderUrl(string folderName)
    {
        var pathSegments = currentPath.Append(folderName)
            .Select(Uri.EscapeDataString);

        return "/walk/" + string.Join('/', pathSegments);
    }

    private static string GetIcon(TP3.Protocol.TP3StatPayload item)
    {
        return item.Info.NodeType == TP3.Messages.NodeType.Directory ? "📁" : "📄";
    }
}
