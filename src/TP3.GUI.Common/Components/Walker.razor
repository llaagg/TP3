@inject TP3ClientWrapper TP3Client

<ul class="list-group list-group-flush">
    @foreach (var item in folderContents)
    {
        if (item.Info.NodeType == TP3.Messages.NodeType.Directory)
        {
            <li class="list-group-item d-flex align-items-center justify-content-between">
                <button class="text-decoration-none fw-semibold" @onclick="() => navigate(item)">
                    <span class="me-2">@GetIcon(item)</span>
                    @item.Name
                </button>
                <span class="badge text-bg-secondary">folder</span>
            </li>
        }
        else
        {
            <li class="list-group-item d-flex align-items-center justify-content-between">
                <span>
                    <span class="me-2">@GetIcon(item)</span>
                    @item.Name
                </span>
                <span class="badge text-bg-primary">file</span>
            </li>
        }
    }
</ul>

@code {
    [Parameter] 
    public string? Folder { get; set; }



    private string[] currentPath = Array.Empty<string>();

    List<TP3.Protocol.TP3StatPayload> folderContents = new List<TP3.Protocol.TP3StatPayload>();

    async Task navigate(TP3.Protocol.TP3StatPayload item)
    {
        currentPath = currentPath.Append(item.Name).ToArray();
        this.folderContents.Clear();
        await load(currentPath.ToArray());
    }

    async Task load(IList<string> path)
    {
        var ourRootSesion = await TP3Client.NewSession(path.ToArray());

         await TP3Client.ListFolder(
            ourRootSesion,
            async (response) =>
        {
            if (response != null)
            {
                folderContents.Add(response);
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    override protected async Task OnInitializedAsync()
    {
        currentPath = string.IsNullOrWhiteSpace(Folder)
            ? Array.Empty<string>()
            : Uri.UnescapeDataString(Folder)
                .Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        await load(this.currentPath);
       
    }

    private string GetFolderUrl(string folderName)
    {
        var pathSegments = currentPath.Append(folderName)
            .Select(Uri.EscapeDataString);

        return "/walk/" + string.Join('/', pathSegments);
    }

    private static string GetIcon(TP3.Protocol.TP3StatPayload item)
    {
        return item.Info.NodeType == TP3.Messages.NodeType.Directory ? "📁" : "📄";
    }
}
