@inject TP3ClientWrapper TP3Client

<div class="d-flex align-items-center mb-3">
    <span class="me-2">Path:</span>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="" class="text-decoration-none" @onclick="NavigateToRoot" @onclick:preventDefault="true">Root</a>
            </li>
            @for (int i = 0; i < currentPath.Length; i++)
            {
                var segment = currentPath[i];
                var idx = i;
                if (i == currentPath.Length - 1)
                {
                    <li class="breadcrumb-item active" aria-current="page">@segment</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <a href="" class="text-decoration-none" @onclick="() => NavigateToSegment(idx)" @onclick:preventDefault="true">@segment</a>
                    </li>
                }
            }
        </ol>
    </nav>
</div>

<ul class="list-group list-group-flush">
    @foreach (var item in folderContents)
    {
        if (item.Info.NodeType == TP3.Messages.NodeType.Directory)
        {
            <WalkerDirectoryItem Item="item" OnDirectoryClick="Navigate" />
        }
        else if (item.Info.NodeType == TP3.Messages.NodeType.Command)
        {
            <WalkerCommandItem Item="item" OnCommandClick="HandleCommandSelected" />
        }
        else
        {
            <WalkerFileItem Item="item" CurrentPath="currentPath" OnFileOpened="HandleFileSelected" />
        }
    }
</ul>

@code {

    [Parameter]
    public EventCallback<(string Tag, string Name,string[] Path)> OnFileSelected { get; set; }

    [Parameter]
    public EventCallback<(string Name, string[] Path)> OnCommandSelected { get; set; }


    private Task HandleFileSelected((string Tag, string Name, string[] Path) item)
    {
        return OnFileSelected.InvokeAsync(item);
    }

    private Task HandleCommandSelected(TP3.Protocol.TP3StatPayload item)
    {
        List<string> pathList = currentPath.ToList();
        pathList.Add(item.Name);
        return OnCommandSelected.InvokeAsync((item.Name, pathList.ToArray()));
    }


    private async Task NavigateToRoot()
    {
        await SetPath(new string[0]);
    }

    private async Task NavigateToSegment(int index)
    {
        var navigatoto = currentPath.Take(index+1).ToArray();
        await SetPath(navigatoto);
    }               

    private string[] currentPath = Array.Empty<string>();

    List<TP3.Protocol.TP3StatPayload> folderContents = new List<TP3.Protocol.TP3StatPayload>();

    async Task Navigate(TP3.Protocol.TP3StatPayload item)
    {
        currentPath = currentPath.Append(item.Name).ToArray();
        this.folderContents.Clear();
        await LoadFolder(currentPath.ToArray());
    }

    async Task LoadFolder(IList<string> path)
    {
        var tag = await TP3Client.NewSession(path.ToArray());

        await TP3Client.ListFolder(
            tag,
            async (response) =>
        {
            if (response != null)
            {
                folderContents.Add(response);
                await InvokeAsync(StateHasChanged);
            }
        });

        await TP3Client.CloseSession(tag);
    }

    override protected async Task OnInitializedAsync()
    {
        await SetPath(Array.Empty<string>());
    }

    private async Task SetPath(string[] newPath)
    {
        currentPath = newPath;
        folderContents.Clear();
        await LoadFolder(this.currentPath);
    }

}
