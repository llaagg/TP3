@using TP3.Protocol.Base
<li class="list-group-item d-flex align-items-center justify-content-between">
    <button class="btn" @onclick="OnClick">
        
        <MetaInfo Element="@Path" Key=MetaField.UTFSymbol ><span class="me-2">📁</span></MetaInfo>
        @Item.Name
    </button>
    <span class="badge text-bg-secondary">folder</span>
</li>

@code {
    [Parameter, EditorRequired]
    public TP3.Protocol.TP3StatPayload Item { get; set; } = default!;

    [Parameter]
    public List<string> Path { get; set; } = default!;

    [Parameter]
    public EventCallback<TP3.Protocol.TP3StatPayload> OnDirectoryClick { get; set; }

    private Task OnClick()
    {
        return OnDirectoryClick.InvokeAsync(Item);
    }
}
