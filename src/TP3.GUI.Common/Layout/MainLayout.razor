@using Microsoft.Extensions.Logging
@using TP3.GUI.Common.Components

@inherits LayoutComponentBase

@inject ILogger logger;
@inject TP3ClientWrapper client;

<div class="bg-black text-light" data-bs-theme="dark">
    <div class="container-fluid min-vh-100 px-0">
        <div class="row g-0 min-vh-100">

            <div class="col d-flex flex-column p-3 p-lg-4">
            
                @Body

                <section class="mt-3 rounded-4 border border-secondary-subtle bg-body-tertiary">
                    <div class="d-flex align-items-center justify-content-between px-2 pt-2 pb-1">
                        <span class="text-uppercase fw-bold small">logs</span>
                        <button class="btn btn-sm btn-outline-light" @onclick="ToggleLockBox">
                            @(ShowLockBox ? "Hide" : "Show")
                        </button>
                    </div>

                    @if (ShowLockBox)
                    {
                        <div class="mx-2 mb-2 px-3 py-2 overflow-auto rounded-3 border border-secondary-subtle bg-dark" style="max-height: 220px;">
                            <LogBox />
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
</div>

@code {
    private bool ShowLockBox { get; set; } = true;

    private void ToggleLockBox()
    {
        ShowLockBox = !ShowLockBox;
    }
}
