<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TP3.GUI.Maui"
             xmlns:tb="https://notifyicon.com/"
             xmlns:components="clr-namespace:TP3.GUI.Common.Components;assembly=TP3.GUI.Common"
             x:Class="TP3.GUI.Maui.MainPage">

    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="TP3"
                        LeftClickCommand="{Binding ToggleWindowCommand}"
                        NoLeftClickDelay="True">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="T"
                                        FontSize="36"
                                        FontWeight="Bold"
                                        Background="Black"
                                        Foreground="White" />
            </tb:TaskbarIcon.IconSource>
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open / Hide"
                                    Command="{Binding ToggleWindowCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit"
                                    Command="{Binding ExitApplicationCommand}" />
                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
        </tb:TaskbarIcon>

        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
