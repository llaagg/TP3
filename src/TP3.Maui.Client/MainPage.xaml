<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TP3.Maui.Client.MainPage"
             Title="TP3 Client">
    <StackLayout Padding="20">
        <Label Text="TP3 MAUI Client" FontSize="24" HorizontalOptions="Center" />
        <Button x:Name="SendButton" Text="Send Command to Agent" Clicked="OnSendClicked" />
        <Label x:Name="StatusLabel" Text="Status: idle" />
    </StackLayout>
</ContentPage>