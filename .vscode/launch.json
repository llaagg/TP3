{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TP3.Server",
      "program": "${workspaceFolder}/src/TP3.Server/bin/Debug/net10.0/TP3.Server.dll",
      "args": [
        "run"
      ],
      "cwd": "${workspaceFolder}/src/TP3.Server",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "CLI - LIST",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TP3.CLI",
      "program": "${workspaceFolder}/src/TP3.CLI/bin/Debug/net10.0/TP3.CLI.dll",
      "args": [
        "list",
      ],
      "cwd": "${workspaceFolder}/src/TP3.CLI",
      "console": "integratedTerminal",
      "stopAtEntry": false,
    },
    {
      "name": "GUI",
      "type": "coreclr",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/TP3.GUI.Maui",
      "preLaunchTask": "build GUI",
      "program": "${workspaceFolder}/src/TP3.GUI.Maui/bin/Debug/net10.0-windows10.0.19041.0/win-x64/TP3.GUI.Maui.exe",
    }
  ],
  "compounds": [
    {
      "name": "Server & GUI",
      "configurations": [ "Server", "GUI"],
      "stopAll": true,
      "preLaunchTask": "build solution with GUI",
      "presentation": {
        "hidden": false,
        "group": "Server",
        "order": 1
      }
    },
    {
      "name": "Server & List",
      "configurations": [ "Server", "CLI - LIST"],
      "stopAll": true,
      "preLaunchTask": "build solution",
      "presentation": {
        "hidden": false,
        "group": "Server",
        "order": 1
      }
    }
  ]
}
