{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TP3.Server",
      "program": "${workspaceFolder}/src/TP3.Server/bin/Debug/net10.0/TP3.Server.dll",
      "args": [
        "run"
      ],
      "cwd": "${workspaceFolder}/src/TP3.Server",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },{
      "name": "Server 6000",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TP3.Server",
      "program": "${workspaceFolder}/src/TP3.Server/bin/Debug/net10.0/TP3.Server.dll",
      "args": [
        "run",
        "--port",
        "6000",
        "--ipc-port",
        "6001"
      ],
      "cwd": "${workspaceFolder}/src/TP3.Server",
      "console": "externalTerminal",
      "stopAtEntry": false
    },
    {
      "name": "CLI - LIST",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build TP3.CLI",
      "program": "${workspaceFolder}/src/TP3.CLI/bin/Debug/net10.0/TP3.CLI.dll",
      "args": [
        "list",
      ],
      "cwd": "${workspaceFolder}/src/TP3.CLI",
      "console": "integratedTerminal",
      "stopAtEntry": false,
    },
    {
      "name": "GUI",
      "type": "coreclr",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/TP3.GUI.Maui",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/TP3.GUI.Maui/TP3.GUI.Maui.csproj",
        "-f",
        "net10.0-windows10.0.19041.0"
      ],
    },
    {
      "name": "GUI Packaged",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "run GUI packaged",
      "processId": "${command:pickProcess}",
      "cwd": "${workspaceFolder}/src/TP3.GUI.Maui"
    },
    {
      "name": "GUI MAUI Run",
      "type": "coreclr",
      "request": "attach",
      "preLaunchTask": "run GUI maui",
      "processId": "${command:pickProcess}",
      "cwd": "${workspaceFolder}/src/TP3.GUI.Maui"
    }
  ],
  "compounds": [
    {
      "name": "Server & GUI",
      "configurations": [ "Server 6000", "GUI"],
      "stopAll": true,
      "preLaunchTask": "build solution",
      "presentation": {
        "hidden": false,
        "group": "Server",
        "order": 1
      }
    },
    {
      "name": "Server & GUI Packaged",
      "configurations": [ "Server 6000", "GUI Packaged"],
      "stopAll": true,
      "preLaunchTask": "build solution",
      "presentation": {
        "hidden": false,
        "group": "Server",
        "order": 1
      }
    },
    {
      "name": "Server & List",
      "configurations": [ "Server", "CLI - LIST"],
      "stopAll": true,
      "preLaunchTask": "build solution",
      "presentation": {
        "hidden": false,
        "group": "Server",
        "order": 1
      }
    }
  ]
}
